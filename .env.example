# Copy to .env for local use. NEVER commit real secrets. Production secrets come from the cloud secret manager.
RegDelta_ENV=local
RegDelta_DATABASE_URL=postgresql+psycopg://RegDelta_app:devpass@localhost/RegDelta
RegDelta_ADMIN_DATABASE_URL=postgresql+psycopg://RegDelta_owner:devpass@localhost/RegDelta
RegDelta_STORAGE_DIR=./var/objects
RegDelta_SCANNER=dev
RegDelta_AI_PROVIDER=mock
# RegDelta_AI_PROVIDER=anthropic
# RegDelta_ANTHROPIC_API_KEY=
# RegDelta_AI_MODEL=claude-sonnet-5-5
# To use OpenRouter, uncomment these and set a model ID from OpenRouter's model catalog.
# Keep the key only in your local .env; never commit it.
# RegDelta_AI_PROVIDER=openrouter
# RegDelta_OPENROUTER_API_KEY=  (or RegDelta_OPENROUTER_API=)
# RegDelta_AI_MODEL=google/gemini-3-flash-preview
# Optional OpenRouter attribution headers:
# RegDelta_OPENROUTER_REFERER=http://localhost:5173
# RegDelta_OPENROUTER_APP_TITLE=RegDelta
# RegDelta_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Required outside local:
# RegDelta_OIDC_ISSUER=  RegDelta_OIDC_AUDIENCE=  RegDelta_OIDC_JWKS_URL=  RegDelta_SECRETS_KEY=
