# Copy these KEY=VALUE pairs into Render's Environment tab.
# Replace every <...> placeholder before saving. Never commit real credentials.
RegDelta_ENV=production
RegDelta_DATABASE_URL=<Neon pooled postgresql+psycopg connection string>
RegDelta_ADMIN_DATABASE_URL=<Neon direct/unpooled postgresql+psycopg connection string>
RegDelta_AI_PROVIDER=openrouter
RegDelta_OPENROUTER_API_KEY=<your existing OpenRouter key>
RegDelta_AI_MODEL=google/gemma-4-31b-it:free
RegDelta_AI_PRICE_IN_PER_MTOK=0
RegDelta_AI_PRICE_OUT_PER_MTOK=0
RegDelta_AI_JOB_BUDGET_USD=0.50
RegDelta_AI_TENANT_DAILY_BUDGET_USD=1.00
RegDelta_DEMO_AUTH_ENABLED=true
RegDelta_DEV_JWT_SECRET=<random secret at least 32 characters>
RegDelta_DEMO_CREDENTIALS={"existing-user-email":"replace-with-strong-password"}
RegDelta_REQUIRE_MFA=false
RegDelta_SECRETS_KEY=<Fernet key>
RegDelta_SCANNER=clamav
RegDelta_CLAMD_HOST=<Render private hostname of your ClamAV service>
RegDelta_CLAMD_PORT=3310
